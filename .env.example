# ─────────────────────────────────────────────────────────────────────────────
# Deenbox — environment variables
# Copy to `.env` for local development. Never commit real values.
# Variables starting with NEXT_PUBLIC_ are visible in the browser — never put
# secrets in them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string (primary source of truth for orders).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/deenbox"

# Random secret (32+ characters) used to hash customer IPs for rate limiting.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=""

# Public URL of the site (used for canonical links, sitemap, Open Graph images).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Client IP for rate limiting (optional) ───────────────────────────────────
# Header your front proxy OVERWRITES with the visitor's IP. Leave empty for Vercel or
# Nginx with `proxy_set_header X-Real-IP $remote_addr;`. Caddy: "x-forwarded-for".
# Cloudflare: "cf-connecting-ip" (only if the server accepts traffic from Cloudflare only).
CLIENT_IP_HEADER=""
# With CLIENT_IP_HEADER="x-forwarded-for": how many proxies append to it (Caddy 1, Cloudflare → Nginx 2).
TRUSTED_PROXY_HOPS=""

# ── Admin bootstrap (only read by `npm run db:seed` / `npm run admin:create`) ─
# Creates the first OWNER account. Remove ADMIN_PASSWORD from .env afterwards;
# change passwords from Admin → My account.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# ── Facebook page ────────────────────────────────────────────────────────────
# Fallback link; the page link can also be edited in Admin → Site settings.
NEXT_PUBLIC_FACEBOOK_PAGE_URL="https://www.facebook.com/profile.php?id=61582403091716"

# ── Google Sheets (service account) — optional but recommended ───────────────
# Orders are always saved to the database first; these only enable the copy
# to Google Sheets. See README → "Google Sheets".
GOOGLE_SHEET_ID=""
GOOGLE_SHEET_TAB="Orders"
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Paste the private_key from the service-account JSON. Keep the \n sequences,
# and wrap the whole value in double quotes.
GOOGLE_PRIVATE_KEY=""

# ── Image storage ────────────────────────────────────────────────────────────
# "local": files in UPLOAD_DIR, served at /media/... (development / VPS hosting)
# "cloudinary": required on serverless hosting (Vercel etc.) where the disk is not persistent
STORAGE_DRIVER="local"
UPLOAD_DIR="./storage/uploads"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Analytics (optional; nothing loads when empty) ───────────────────────────
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# ── New-order alerts on Telegram (optional) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ── Scheduled Google Sheet catch-up (optional) ───────────────────────────────
# Enables GET /api/cron/sheets-sync with header  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# ── Development & testing (optional) ─────────────────────────────────────────
# Separate, disposable database for `npm test` (integration tests wipe it).
TEST_DATABASE_URL=""
# Max database connections per server instance (default 10).
DATABASE_POOL_SIZE=""
# Initial delivery charges used by `npm run db:seed` (otherwise ৳0 — set real values in Admin → Delivery).
SEED_DELIVERY_INSIDE=""
SEED_DELIVERY_OUTSIDE=""
# Base URL for Playwright end-to-end tests (default http://localhost:3000).
E2E_BASE_URL=""
