// Deenbox database schema.
// All money values are whole Bangladeshi Taka (Int). Prices in BD retail are
// quoted in whole taka; percentage discounts are rounded to the nearest taka.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  ON_HOLD
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum SheetSyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
}

enum AdminRole {
  OWNER
  STAFF
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum CouponType {
  PERCENT
  FIXED
  FREE_DELIVERY
}

// ─── Catalog ────────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  /// Bangla hero headline shown above the product name.
  headline         String?
  shortDescription String?
  description      String?
  /// Label for the variant picker, e.g. "সাইজ" or "রং".
  variantLabel     String        @default("ধরন")
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  sortOrder        Int           @default(0)
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Max total quantity of this product per order. Null = site default.
  maxPerOrder      Int?
  /// [{ title, description }]
  benefits         Json          @default("[]")
  /// string[]
  includedItems    Json          @default("[]")
  /// [{ label, value }]
  specifications   Json          @default("[]")
  /// string[]
  howToUse         Json          @default("[]")
  /// string[]
  importantNotes   Json          @default("[]")
  /// [{ question, answer }]
  faqs             Json          @default("[]")
  seoTitle         String?
  seoDescription   String?

  images            ProductImage[]
  variants          ProductVariant[]
  quantityDiscounts QuantityDiscount[]
  reviews           Review[]
  orderItems        OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sortOrder])
  @@index([categoryId])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  /// Storage-provider key, used to delete the file.
  storageKey String
  alt        String?
  width      Int
  height     Int
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([productId, sortOrder])
}

model ProductVariant {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  sku            String?     @unique
  price          Int
  /// Previous price, shown struck through when higher than price.
  compareAtPrice Int?
  /// Null = stock not tracked.
  stock          Int?
  isActive       Boolean     @default(true)
  sortOrder      Int         @default(0)
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([productId, sortOrder])
}

/// "Buy N or more of this product, get a discount" tiers.
model QuantityDiscount {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQuantity Int
  type        DiscountType
  /// Percent (1–100) for PERCENT, taka for FIXED (per order line group).
  value       Int
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([productId, minQuantity])
}

model Coupon {
  id                String     @id @default(cuid())
  /// Stored uppercase.
  code              String     @unique
  description       String?
  type              CouponType
  /// Percent for PERCENT, taka for FIXED, ignored for FREE_DELIVERY.
  value             Int        @default(0)
  /// Minimum subtotal (after quantity discounts) to use the coupon.
  minOrderAmount    Int?
  /// Cap for PERCENT coupons.
  maxDiscountAmount Int?
  startsAt          DateTime?
  endsAt            DateTime?
  usageLimit        Int?
  usedCount         Int        @default(0)
  perPhoneLimit     Int?
  isActive          Boolean    @default(true)
  orders            Order[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Review {
  id           String   @id @default(cuid())
  /// Null = general store review.
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  customerName String
  location     String?
  rating       Int
  text         String
  imageUrl     String?
  imageKey     String?
  isPublished  Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId, isPublished])
}

// ─── Delivery ───────────────────────────────────────────────────────────────

model DeliveryZone {
  id                String             @id @default(cuid())
  name              String
  charge            Int
  /// Zone used when no district/area rule matches. Exactly one should be default.
  isDefault         Boolean            @default(false)
  estimatedDelivery String?
  sortOrder         Int                @default(0)
  areas             DeliveryZoneArea[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

/// Maps a district (areaId = "") or a specific area/thana to a zone.
/// Area rules win over district rules.
model DeliveryZoneArea {
  id         String       @id @default(cuid())
  zoneId     String
  zone       DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  districtId String
  areaId     String       @default("")

  @@unique([districtId, areaId])
  @@index([zoneId])
}

// ─── Orders ─────────────────────────────────────────────────────────────────

model Order {
  id               String      @id @default(cuid())
  orderNumber      String      @unique
  /// Unguessable token for the customer's confirmation page.
  publicToken      String      @unique
  idempotencyKey   String      @unique
  customerName     String
  mobileNumber     String
  division         String
  district         String
  area             String
  divisionId       String
  districtId       String
  areaId           String?
  address          String
  customerNote     String?
  /// Message the customer wants with the gift (written on a card), if any.
  giftMessage      String?
  giftWrap         Boolean     @default(false)
  /// What gift wrapping cost on this order (0 when not chosen); part of totalAmount.
  giftWrapCharge   Int         @default(0)
  itemCount        Int
  subtotal         Int
  quantityDiscount Int         @default(0)
  couponDiscount   Int         @default(0)
  discount         Int         @default(0)
  deliveryCharge   Int
  deliveryZoneName String
  totalAmount      Int
  couponId         String?
  coupon           Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode       String?
  orderStatus      OrderStatus @default(PENDING)
  adminNote        String?
  isFlagged        Boolean     @default(false)
  flagReason       String?
  ipHash           String?
  userAgent        String?

  googleSheetSyncStatus    SheetSyncStatus @default(PENDING)
  googleSheetRowReference  String?
  googleSheetLastSyncAt    DateTime?
  googleSheetSyncError     String?
  /// Bumped whenever sheet-visible data changes (e.g. status).
  googleSheetVersion       Int             @default(1)
  /// Version last written to the sheet. Up to date when equal to googleSheetVersion.
  googleSheetSyncedVersion Int             @default(0)
  /// Random lease token held by the worker currently syncing this order.
  googleSheetSyncLease     String?
  googleSheetSyncStartedAt DateTime?
  googleSheetSyncAttempts  Int             @default(0)

  items  OrderItem[]
  events OrderEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mobileNumber])
  @@index([createdAt])
  @@index([orderStatus])
  @@index([googleSheetSyncStatus])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName    String
  variantName    String?
  sku            String?
  unitPrice      Int
  compareAtPrice Int?
  quantity       Int
  lineSubtotal   Int
  /// Share of the product's quantity discount allocated to this line.
  lineDiscount   Int             @default(0)
  /// True while this line holds units taken from the variant's stock. Lines of
  /// untracked variants never do, so cancelling only returns what was taken.
  stockReserved  Boolean         @default(false)

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       String
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  message    String?
  actorId    String?
  actor      AdminUser?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName  String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

/// Per-day sequence for human-readable order numbers (DBX-YYYYMMDD-NNNN).
model OrderCounter {
  /// Dhaka-local date, YYYYMMDD.
  date  String @id
  value Int
}

// ─── Admin & infrastructure ─────────────────────────────────────────────────

model AdminUser {
  id           String         @id @default(cuid())
  username     String         @unique
  displayName  String
  passwordHash String
  role         AdminRole      @default(STAFF)
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  sessions     AdminSession[]
  events       OrderEvent[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model AdminSession {
  id         String    @id @default(cuid())
  /// SHA-256 of the session token; the raw token only lives in the cookie.
  tokenHash  String    @unique
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  ipHash     String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Fixed-window rate limit counters (works on serverless and multi-instance).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// Admin-editable site settings, stored as validated JSON documents.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// A checkout someone started but did not finish: name, phone and cart, saved once the phone
/// number is valid so staff can call to help. One per phone; removed when that phone places
/// an order, and after 30 days.
model CheckoutLead {
  id           String    @id @default(cuid())
  mobileNumber String    @unique
  customerName String
  /// District name in Bangla, when chosen.
  district     String?
  /// [{ name, quantity }] at the time of the last update.
  items        Json
  /// Product total at list prices, before discounts and delivery.
  subtotal     Int
  ipHash       String?
  contactedAt  DateTime?
  contactedBy  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([updatedAt])
}
